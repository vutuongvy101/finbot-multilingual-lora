HF_TOKEN=hf_xx # required for first-time model download from Hugging Face
HF_CACHE_DIR="~/.cache/huggingface/hub"
HF_LOCAL_FILES_ONLY=0

# Model serving (local in-process Hugging Face + PEFT by default)
FINBOT_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
FINBOT_ADAPTER_REPO=bibbbu/lora-qwen25-1p5b-finbot-v2
# FINBOT_ADAPTER_PATH=artifacts/lora-qwen25-1p5b-finbot-v2  # optional local override
FINBOT_ADAPTER_MODEL_ID=lora-qwen25-1p5b-finbot-v2

# Inference backend: local | vllm | ollama
FINBOT_LLM_BACKEND=local

# vLLM (OpenAI-compatible server; use with: docker compose --profile vllm up)
# FINBOT_LLM_BACKEND=vllm
# FINBOT_VLLM_BASE_URL=http://127.0.0.1:8001/v1
# FINBOT_VLLM_LORA_MODEL=finbot

# Ollama (requires a merged/custom model: ollama create finbot -f Modelfile)
# FINBOT_LLM_BACKEND=ollama
# FINBOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# FINBOT_OLLAMA_MODEL=finbot
